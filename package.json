{
  "name": "electronics-inventory",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local --persist-to .wrangler/state",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:web && pnpm test:integration",
    "test:api": "vitest run tests/api --pool=vmThreads --maxWorkers=1",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:web": "vitest run tests/web --pool=vmThreads --maxWorkers=1",
    "verify:cloudflare-secrets": "node ./scripts/verify-cloudflare-secrets.js",
    "deploy": "pnpm build && pnpm db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply parts-inventory --local",
    "db:migrate:remote": "wrangler d1 migrations apply parts-inventory --remote"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.11",
    "wrangler": "^4.164.0",
    "@vitejs/plugin-react": "^6.3.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "postcss-selector-parser": "^7.1.6",
      "dompurify": "^3.4.18"
    }
  }
}
